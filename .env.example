# Copy to `.env` for local development:  cp .env.example .env
# In production set these as environment variables / secrets on your host
# instead — never commit a real key.

# ---- Required -------------------------------------------------------------
# Free, no credit card: https://console.groq.com/keys
GROQ_API_KEY=gsk_replace_me

# ---- Optional -------------------------------------------------------------
# Second provider for redundancy: https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIza_replace_me

# "groq" (default) or "gemini"
# LLM_PROVIDER=groq

# Model overrides. Defaults balance Groq's per-model daily budgets:
# the 8B model allows ~14,400 req/day, the 70B model ~1,000 req/day.
# QUESTION_MODEL=llama-3.1-8b-instant
# SCORING_MODEL=llama-3.3-70b-versatile
# FALLBACK_MODEL=llama-3.1-8b-instant
# STT_MODEL=whisper-large-v3-turbo

# Let visitors paste their own key to bypass the shared rate limit.
# ALLOW_USER_API_KEY=true

# Network behaviour
# REQUEST_TIMEOUT=45
# MAX_RETRIES=3

# Soft per-session abuse guards
# MAX_QUESTIONS=8
# MAX_INTERVIEWS_PER_SESSION=12
# MAX_REGENERATIONS_PER_SESSION=20
# MAX_STT_UPLOAD_BYTES=8388608
